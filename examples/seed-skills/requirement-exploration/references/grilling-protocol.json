{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillhive.local/protocols/requirement-exploration-grilling-1.0.json",
  "protocol": "grill-me",
  "version": "1.0",
  "decisionModel": "design-tree",
  "questionStrategy": "complete-frontier-per-round",
  "recomputeFrontierAfterEachRound": true,
  "questionFormat": {
    "numbered": true,
    "titled": true,
    "recommendationRequired": true
  },
  "factOwner": "assistant",
  "decisionOwner": "user",
  "requiresSharedUnderstandingConfirmation": true,
  "requiresSeparateSubmissionConfirmation": true,
  "prohibitActionBeforeConfirmation": true
}
