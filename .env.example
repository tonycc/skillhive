# PostgreSQL 连接串
DATABASE_URL=postgres://postgres:postgres@localhost:5434/skillhive

# Redis（缓存/限流，二期启用）
REDIS_URL=redis://localhost:6379

# Registry 服务端口
REGISTRY_PORT=3001

# MCP Server 访问 Registry 的地址
SKILLHIVE_REGISTRY_URL=http://localhost:3001

# 发布接口令牌（Registry 配置后，发布/管理接口需携带；缺省 = 本地开发无鉴权模式，正式部署必须配置）
SKILLHIVE_PUBLISH_TOKEN=

# CLI publish 使用的发布令牌（发布者本机配置）
SKILLHIVE_TOKEN=

# 统一登录模块（二期接入）
WECOM_CORP_ID=
WECOM_APP_SECRET=
