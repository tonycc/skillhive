# PostgreSQL 连接串
DATABASE_URL=postgres://postgres:postgres@localhost:5434/skillhive

# Redis（缓存/限流，二期启用）
REDIS_URL=redis://localhost:6379

# Registry 服务端口
REGISTRY_PORT=3001

# WorkBuddy 状态检查中展示的企业名称
SKILLHIVE_COMPANY_NAME=本企业

# WorkBuddy 官方连接器运营状态（仅管理端展示，不包含任何凭据）
WORKBUDDY_CONNECTOR_SOURCE=skillhive
WORKBUDDY_CONNECTOR_VERSION=1.2.0
WORKBUDDY_MIN_CLIENT_VERSION=4.24.0
# 正式包使用的完整 HTTPS 地址，必须以 /mcp 结尾
WORKBUDDY_CONNECTOR_MCP_URL=
WORKBUDDY_CONNECTOR_ENVIRONMENT=unconfigured
WORKBUDDY_CONNECTOR_REVIEW_STATUS=not_submitted
# 审核通过后填写正式市场入口；实测字段在真实客户端验证后填写
WORKBUDDY_CONNECTOR_MARKET_URL=
WORKBUDDY_VERIFIED_CLIENT_VERSION=
WORKBUDDY_VERIFIED_OS=
WORKBUDDY_VERIFIED_AT=

# 需求探索保留期（清理命令默认只做 dry-run）
EXPLORATION_DRAFT_RETENTION_DAYS=90
EXPLORATION_SUBMITTED_RETENTION_DAYS=365

# MCP Server 访问 Registry 的地址
SKILLHIVE_REGISTRY_URL=http://localhost:3001

# 仅本地 stdio/兼容模式使用：管理员定向发放的员工专属令牌（不要提交到版本库）
# SKILLHIVE_PAT=sk-...

# MCP HTTP/SSE 资源上限（默认值如下）
MCP_MAX_SSE_SESSIONS=100
MCP_MAX_SSE_SESSIONS_PER_USER=5
MCP_SSE_MAX_AGE_MS=28800000
# 已认证的单枚员工令牌每分钟最多请求数；无效凭证另按来源 IP 限制
MCP_MAX_REQUESTS_PER_TOKEN=240
# 来源 IP 每分钟的认证前洪泛上限；正常员工额度仍按各自令牌隔离
MCP_MAX_PREAUTH_REQUESTS_PER_IP=10000

# 登录会话密钥（JWT HS256；生产环境必须配置至少 32 字符的随机值）
SKILLHIVE_SESSION_SECRET=

# 服务间内部接口共享密钥（Registry 与 MCP Server 配置同一随机值，至少 32 字符）
SKILLHIVE_INTERNAL_TOKEN=

# 对用户公开的 MCP URL。仅支持根路径 /sse，可用同源相对地址或独立 HTTPS 地址。
PUBLIC_MCP_URL=/sse
# 仅在已确认全链路位于受控明文网络时使用；默认生产 MCP 拒绝非 HTTPS 请求。
# SKILLHIVE_ALLOW_HTTP=1

# 生产默认仅监听本机，由 TLS 反向代理对外提供服务。确认网络边界后再调整。
CONSOLE_BIND_ADDRESS=127.0.0.1
REGISTRY_BIND_ADDRESS=127.0.0.1
MCP_BIND_ADDRESS=127.0.0.1

# 生产部署：数据库账号（docker-compose.prod.yml 使用）
POSTGRES_USER=skillhive
# 至少 16 字符且不得使用常见默认值；上线前运行 validate:production
POSTGRES_PASSWORD=
POSTGRES_DB=skillhive

# 生产部署：首次启动引导管理员（create-user 逻辑，验证后建议移除）
# SKILLHIVE_ADMIN_EMAIL=
# SKILLHIVE_ADMIN_NAME=管理员
# SKILLHIVE_ADMIN_PASSWORD=
