# PostgreSQL 连接串
DATABASE_URL=postgres://postgres:postgres@localhost:5434/skillhive

# Redis（缓存/限流，二期启用）
REDIS_URL=redis://localhost:6379

# Registry 服务端口
REGISTRY_PORT=3001

# MCP Server 访问 Registry 的地址
SKILLHIVE_REGISTRY_URL=http://localhost:3001

# 仅本地 stdio 模式使用：Console 生成的个人接入令牌（不要提交到版本库）
# SKILLHIVE_PAT=sk-...

# MCP HTTP/SSE 资源上限（默认值如下）
MCP_MAX_SSE_SESSIONS=100
MCP_MAX_SSE_SESSIONS_PER_USER=5
MCP_SSE_MAX_AGE_MS=28800000

# 登录会话密钥（JWT HS256；生产环境必须配置至少 32 字符的随机值）
SKILLHIVE_SESSION_SECRET=

# 服务间内部接口共享密钥（Registry 与 MCP Server 配置同一随机值，至少 32 字符）
SKILLHIVE_INTERNAL_TOKEN=

# 对用户公开的 MCP URL。仅支持根路径 /sse，可用同源相对地址或独立 HTTPS 地址。
PUBLIC_MCP_URL=/sse
# 仅在已确认全链路位于受控明文网络时使用；默认生产 MCP 拒绝非 HTTPS 请求。
# SKILLHIVE_ALLOW_HTTP=1

# 生产默认仅监听本机，由 TLS 反向代理对外提供服务。确认网络边界后再调整。
CONSOLE_BIND_ADDRESS=127.0.0.1
REGISTRY_BIND_ADDRESS=127.0.0.1
MCP_BIND_ADDRESS=127.0.0.1

# 生产部署：数据库账号（docker-compose.prod.yml 使用）
POSTGRES_USER=skillhive
POSTGRES_PASSWORD=
POSTGRES_DB=skillhive

# 生产部署：首次启动引导管理员（create-user 逻辑，验证后建议移除）
# SKILLHIVE_ADMIN_EMAIL=
# SKILLHIVE_ADMIN_NAME=管理员
# SKILLHIVE_ADMIN_PASSWORD=
