# SkillHive 服务端共享镜像（registry / mcp-server 共用，以 command 区分启动角色）
#
# workspace 包的 main 直接指向 TS 源码，因此镜像内以 tsx 运行，无需编译编排。

FROM node:22-alpine
# 网络环境访问 npmjs 不稳定：corepack 下载 pnpm 与 pnpm 安装依赖均走国内镜像
ENV COREPACK_NPM_REGISTRY=https://registry.npmmirror.com
RUN corepack enable \
  && pnpm config set registry https://registry.npmmirror.com \
  && pnpm config set fetch-retries 5

WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile

ENV NODE_ENV=production
RUN chmod +x deploy/entrypoint-registry.sh
