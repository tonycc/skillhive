# Console 镜像：vite 构建静态产物 + nginx 托管（/api 反向代理到 registry）

FROM node:22-alpine AS build
# 网络环境访问 npmjs 不稳定：corepack 下载 pnpm 与 pnpm 安装依赖均走国内镜像
ENV COREPACK_NPM_REGISTRY=https://registry.npmmirror.com
RUN corepack enable \
  && pnpm config set registry https://registry.npmmirror.com \
  && pnpm config set fetch-retries 5
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile && pnpm --filter @skillhive/console build

FROM nginx:alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/console/dist /usr/share/nginx/html
