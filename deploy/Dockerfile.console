# Console 镜像：vite 构建静态产物 + nginx 托管（/api 反向代理到 registry）

FROM node:22-alpine AS build
# 默认使用官方源；受限网络可通过 --build-arg NPM_REGISTRY=... 覆盖。
ARG NPM_REGISTRY=https://registry.npmjs.org
ENV COREPACK_NPM_REGISTRY=$NPM_REGISTRY
RUN corepack enable \
  && pnpm config set registry "$NPM_REGISTRY" \
  && pnpm config set fetch-retries 5
WORKDIR /app
COPY . .
ARG VITE_MCP_URL=/sse
ENV VITE_MCP_URL=$VITE_MCP_URL
RUN pnpm install --frozen-lockfile --prod=false && pnpm --filter @skillhive/console... build

FROM nginx:1.28-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/console/dist /usr/share/nginx/html
