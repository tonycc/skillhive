{
  "name": "@skillhive/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file-if-exists=../../.env src/http.ts",
    "dev:stdio": "tsx watch --conditions=development src/index.ts",
    "build": "tsc -p tsconfig.json",
    "load:workbuddy": "tsx --conditions=development src/load-test.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "test": "vitest run src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@skillhive/skill-schema": "workspace:*",
    "express": "^4.21.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.22",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
