{
  "name": "@skillhive/registry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file-if-exists=../../.env src/index.ts",
    "create-user": "tsx --conditions=development src/scripts/create-user.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@hono/zod-validator": "^0.7.0",
    "@skillhive/db": "workspace:*",
    "@skillhive/skill-schema": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.8.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3"
  }
}
